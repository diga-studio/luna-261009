{
  "name": "step-index",
  "version": "0.1.0",
  "private": true,
  "description": "STEP (ISO-10303-21) structure index library backed by SQLite",
  "type": "module",
  "main": "./dist/src/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test \"dist/test/*.test.js\""
  },
  "devDependencies": {
    "typescript": "5.8.2",
    "@types/node": "24.12.2"
  },
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
